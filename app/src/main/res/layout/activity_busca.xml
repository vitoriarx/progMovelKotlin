<?xml version="1.0" encoding="utf-8"?>

<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/background">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="20dp">

        <TextView
            android:id="@+id/btnVoltarBusca"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="‹"
            android:textColor="@color/green_dark"
            android:textSize="40sp"
            android:padding="4dp"
            android:clickable="true"
            android:focusable="true" />

        <!-- Título -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Buscar"
            android:textColor="@color/green_dark"
            android:textSize="28sp"
            android:textStyle="bold" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:text="Encontre tudo o que precisa em Arapiraca"
            android:textColor="@color/text_secondary"
            android:textSize="15sp" />

        <!-- Campo de busca -->
        <EditText
            android:id="@+id/edtBusca"
            android:layout_width="match_parent"
            android:layout_height="54dp"
            android:layout_marginTop="24dp"
            android:backgroundTint="@color/green_primary"
            android:hint="O que você procura hoje?"
            android:padding="14dp"
            android:singleLine="true"
            android:textColor="@color/text_primary"
            android:textColorHint="@color/text_secondary" />

        <!-- Seção -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="30dp"
            android:text="Acesso rápido"
            android:textColor="@color/text_primary"
            android:textSize="20sp"
            android:textStyle="bold" />

        <!-- Primeira linha -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:orientation="horizontal">

            <Button
                android:id="@+id/btnRestaurantes"
                android:layout_width="0dp"
                android:layout_height="120dp"
                android:layout_weight="1"
                android:backgroundTint="@color/gold_light"
                android:text="🍴\nRestaurantes"
                android:textAllCaps="false"
                android:textColor="@color/green_dark"
                android:textSize="15sp"
                android:textStyle="bold" />

            <Button
                android:id="@+id/btnAcademias"
                android:layout_width="0dp"
                android:layout_height="120dp"
                android:layout_marginStart="12dp"
                android:layout_weight="1"
                android:backgroundTint="@color/green_light"
                android:text="🏋\nAcademias"
                android:textAllCaps="false"
                android:textColor="@color/green_dark"
                android:textSize="15sp"
                android:textStyle="bold" />

        </LinearLayout>

        <!-- Segunda linha -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:orientation="horizontal">

            <Button
                android:id="@+id/btnLojas"
                android:layout_width="0dp"
                android:layout_height="120dp"
                android:layout_weight="1"
                android:backgroundTint="@color/green_light"
                android:text="🛍\nLojas"
                android:textAllCaps="false"
                android:textColor="@color/green_dark"
                android:textSize="15sp"
                android:textStyle="bold" />

            <Button
                android:id="@+id/btnBares"
                android:layout_width="0dp"
                android:layout_height="120dp"
                android:layout_marginStart="12dp"
                android:layout_weight="1"
                android:backgroundTint="@color/gold_light"
                android:text="🍹\nBares"
                android:textAllCaps="false"
                android:textColor="@color/green_dark"
                android:textSize="15sp"
                android:textStyle="bold" />

        </LinearLayout>

        <!-- Mais seções -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="30dp"
            android:text="Explore Arapiraca"
            android:textColor="@color/text_primary"
            android:textSize="20sp"
            android:textStyle="bold" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="Encontre serviços, empresas e lugares próximos de você."
            android:textColor="@color/text_secondary"
            android:textSize="15sp" />

    </LinearLayout>

</ScrollView>